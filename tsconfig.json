{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "paths": { "@/*": ["./*"] }
  },
  "include": ["main.tsx", "vite.config.ts", "app/**/*.ts", "app/**/*.tsx", "lib/**/*.mjs", "legacy-evolution/**/*.ts", "legacy-evolution/**/*.tsx", "types/**/*.d.ts"],
  "exclude": ["node_modules", "dist"]
}
